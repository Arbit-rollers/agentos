# Copy to .env and adjust. Never commit .env.

# PostgreSQL (pgvector image in docker-compose)
DATABASE_URL=postgres://agentos:agentos@localhost:5432/agentos
# Separate database for integration tests; it is truncated between tests.
TEST_DATABASE_URL=postgres://agentos:agentos@localhost:5432/agentos_test

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Required. 32-byte key, base64-encoded. Generate with: openssl rand -base64 32
# Encrypts provider API keys, MCP credentials and OAuth tokens (PRD §21).
AGENTOS_MASTER_KEY=

# Local models (Ollama running on the host)
OLLAMA_BASE_URL=http://localhost:11434

# Public URL of the web app
APP_URL=http://localhost:3000

# Optional: AgentOS's own Google OAuth client (Web application, redirect URI
# ${APP_URL}/api/mcp/oauth/callback). Lets tenants connect Google Workspace with one click;
# without it they bring their own client ID and secret.
# AGENTOS_GOOGLE_CLIENT_ID=
# AGENTOS_GOOGLE_CLIENT_SECRET=

# Reliability (v0.6). Rate limits on sign-in, sign-up and starting chats/tasks default to on in
# production and off otherwise.
# AGENTOS_RATE_LIMITS=on
# Per workspace: queued runs before new chats/tasks are refused, and runs executing at once.
# AGENTOS_MAX_QUEUED_RUNS=100
# AGENTOS_MAX_RUNNING_RUNS=3
