{
  "name": "@agentos/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Domain services shared by web and worker: env, queues, health, agents, tasks, audit (PRD §24).",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p .",
