    "@agentos/mcp-gateway": "workspace:*",
    "@agentos/model-gateway": "workspace:*",
    "@agentos/personality": "workspace:*",
    "@agentos/policy": "workspace:*",
    "@node-rs/argon2": "~2.2.1",
    "ajv": "8.17.1",
    "bullmq": "^6.3.11",
    "cron-parser": "5.10.1",
    "ioredis": "^6.0.0",
    "unpdf": "1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsx": "^4.23.15"
  }
}
